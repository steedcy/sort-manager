.overview-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.overview-head > view:first-child { flex: 1; min-width: 0; }
.ledger-seal { flex: none; display: flex; flex-direction: column; align-items: center; width: 132rpx; padding: 18rpx 8rpx; color: #312e81; background: #eef2ff; border: 2rpx solid #a5b4fc; border-radius: 16rpx; font-size: 22rpx; font-weight: 750; }
.ledger-seal__dot { width: 12rpx; height: 12rpx; margin-bottom: 8rpx; background: #047857; border-radius: 50%; }
.ledger-seal__small { color: #64748b; font-size: 19rpx; font-weight: 500; }
.metric-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-top: 12rpx; }
.metric { display: flex; flex-direction: column; min-height: 168rpx; padding: 28rpx; background: #fff; border: 2rpx solid #dbe3ef; border-radius: 20rpx; }
.metric--primary { color: #fff; background: #3730a3; border-color: #3730a3; }
.metric--notice { background: #fffbeb; border-color: #fcd34d; }
.metric__value { font-size: 56rpx; font-weight: 800; line-height: 1.1; }
.metric__label { margin-top: auto; font-size: 24rpx; opacity: .82; }
.asset-strip { display: flex; align-items: center; justify-content: space-between; margin: 24rpx 0 8rpx; padding: 28rpx 30rpx; background: #fff; border-left: 8rpx solid #047857; border-radius: 4rpx 18rpx 18rpx 4rpx; }
.asset-strip__label { color: #64748b; font-size: 24rpx; }
.asset-strip__value { margin-top: 4rpx; font-size: 38rpx; font-weight: 760; }
.section-row { display: flex; align-items: center; justify-content: space-between; }
.section-row__action { width: auto; min-width: 160rpx; margin: 20rpx -20rpx 0 0; font-size: 26rpx; }
.recent-list { overflow: hidden; background: #fff; border: 2rpx solid #dbe3ef; border-radius: 20rpx; }
.recent-item { display: flex; align-items: center; min-height: 112rpx; padding: 18rpx 24rpx; border-bottom: 2rpx solid #edf2f7; }
.recent-item:last-child { border-bottom: 0; }
.recent-item__index { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; margin-right: 20rpx; color: #4338ca; background: #eef2ff; border-radius: 12rpx; font-size: 22rpx; font-weight: 750; }
.recent-item__body { flex: 1; min-width: 0; }
.recent-item__name { overflow: hidden; font-weight: 680; text-overflow: ellipsis; white-space: nowrap; }
.recent-item__meta { overflow: hidden; color: #64748b; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
