<view class="login-page">
  <view class="ledger-mark" aria-label="家庭物品账本标识">
    <view class="ledger-mark__line"></view>
    <text class="ledger-mark__title">家庭物品账本</text>
    <text class="ledger-mark__code">HOME · INDEX</text>
  </view>

  <view class="login-card">
    <text class="page-kicker">SORT MANAGER</text>
    <view class="page-title">回家看看</view>
    <view class="page-lead">登录后查找、统计并随手登记家里的物品。</view>

    <view class="field">
      <label class="field-label" for="username">用户名</label>
      <input id="username" class="input" value="{{username}}" placeholder="输入家庭账号" maxlength="50" bindinput="onUsernameInput" />
    </view>
    <view class="field">
      <label class="field-label" for="password">密码</label>
      <input id="password" class="input" value="{{password}}" password placeholder="输入密码" maxlength="100" confirm-type="done" bindinput="onPasswordInput" bindconfirm="submit" />
    </view>
    <view wx:if="{{error}}" class="login-error" role="alert">{{error}}</view>
    <button class="button-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">
      {{submitting ? '正在登录' : '登录'}}
    </button>
  </view>
  <view class="login-footnote">仅连接你的家庭服务器 · 会话安全保存在本机</view>
</view>
