.items-page { padding-bottom: calc(72rpx + env(safe-area-inset-bottom)); }
.search-bar { display: flex; align-items: center; box-sizing: border-box; min-height: 96rpx; margin-bottom: 24rpx; padding: 0 12rpx 0 24rpx; background: #fff; border: 2rpx solid #cbd5e1; border-radius: 20rpx; }
.search-glyph { box-sizing: border-box; width: 28rpx; height: 28rpx; margin-right: 18rpx; border: 4rpx solid #4338ca; border-radius: 50%; }
.search-glyph::after { display: block; width: 14rpx; height: 4rpx; margin: 22rpx 0 0 20rpx; background: #4338ca; content: ''; transform: rotate(45deg); }
.search-input { flex: 1; min-width: 0; height: 88rpx; font-size: 30rpx; }
.search-clear { width: auto; min-width: 88rpx; min-height: 80rpx; margin: 0; padding: 0 12rpx; color: #4338ca; background: transparent; font-size: 25rpx; line-height: 80rpx; }
.item-card { margin-bottom: 18rpx; padding: 28rpx; background: #fff; border: 2rpx solid #dbe3ef; border-radius: 20rpx; }
.item-card__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.item-card__name { flex: 1; min-width: 0; font-size: 32rpx; font-weight: 720; overflow-wrap: anywhere; }
.item-card__quantity { flex: none; padding: 6rpx 14rpx; color: #3730a3; background: #eef2ff; border-radius: 10rpx; font-size: 25rpx; font-weight: 700; }
.item-card__meta, .item-card__date { margin-top: 12rpx; color: #64748b; font-size: 25rpx; }
.item-card__date { color: #92400e; }
.meta-separator { padding: 0 12rpx; color: #cbd5e1; }
.list-footer { padding: 28rpx 0 12rpx; color: #64748b; font-size: 24rpx; text-align: center; }
.empty-mark { display: flex; justify-content: center; gap: 8rpx; margin-bottom: 24rpx; }
.empty-mark view { width: 28rpx; height: 64rpx; background: #c7d2fe; border-radius: 5rpx; }
.empty-mark view:nth-child(2) { height: 88rpx; margin-top: -24rpx; background: #818cf8; }
