.add-page { padding-bottom: calc(72rpx + env(safe-area-inset-bottom)); }
.entry-ticket { display: flex; align-items: stretch; margin-bottom: 24rpx; color: #fff; background: #3730a3; border-radius: 18rpx; overflow: hidden; }
.entry-ticket__number { display: flex; align-items: center; justify-content: center; width: 132rpx; min-height: 112rpx; color: #c7d2fe; border-right: 2rpx dashed #818cf8; font-size: 25rpx; font-weight: 800; letter-spacing: 3rpx; }
.entry-ticket__body { display: flex; flex: 1; flex-direction: column; justify-content: center; padding: 20rpx 24rpx; font-weight: 700; }
.entry-ticket__sub { margin-top: 4rpx; color: #c7d2fe; font-size: 22rpx; font-weight: 450; }
.form-card { padding-bottom: 36rpx; }
.more-toggle { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; width: 100%; min-height: 88rpx; margin: 0 0 28rpx; padding: 0 4rpx; color: #4338ca; background: transparent; border-top: 2rpx solid #e2e8f0; border-bottom: 2rpx solid #e2e8f0; border-radius: 0; font-size: 27rpx; font-weight: 680; text-align: left; }
.more-toggle__mark { font-size: 42rpx; font-weight: 400; }
.optional-fields { padding-top: 4rpx; }
.metadata-note, .metadata-error { margin-bottom: 24rpx; padding: 18rpx 20rpx; color: #64748b; background: #f8fafc; border-radius: 12rpx; font-size: 24rpx; }
.metadata-error { display: flex; align-items: center; justify-content: space-between; color: #b91c1c; background: #fef2f2; }
.metadata-retry { width: auto; min-width: 88rpx; min-height: 72rpx; margin: 0; padding: 0 16rpx; color: #b91c1c; background: transparent; font-size: 24rpx; line-height: 72rpx; }
.submit-button { margin-top: 8rpx; }
