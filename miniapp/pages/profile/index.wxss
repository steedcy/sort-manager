.profile-page { padding-bottom: calc(72rpx + env(safe-area-inset-bottom)); }
.identity-card { display: flex; align-items: center; margin-top: 20rpx; padding: 32rpx; background: #fff; border: 2rpx solid #dbe3ef; border-radius: 24rpx; }
.identity-card__avatar { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; margin-right: 24rpx; color: #fff; background: #3730a3; border-radius: 24rpx; font-size: 40rpx; font-weight: 800; }
.identity-card__body { flex: 1; min-width: 0; }
.identity-card__name { overflow: hidden; font-size: 34rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.identity-card__username { color: #64748b; font-size: 24rpx; }
.household-card { display: flex; overflow: hidden; min-height: 152rpx; background: #fff; border: 2rpx solid #dbe3ef; border-radius: 20rpx; }
.household-card__rail { width: 18rpx; margin-right: 28rpx; background: #4338ca; }
.household-card > view:last-child { display: flex; flex-direction: column; justify-content: center; }
.household-card__label { color: #64748b; font-size: 23rpx; }
.household-card__name { font-size: 34rpx; font-weight: 740; }
.household-card__id { color: #94a3b8; font-size: 21rpx; }
.privacy-note { margin: 32rpx 0; padding: 24rpx 28rpx; color: #475569; background: #eef2ff; border-radius: 16rpx; font-size: 25rpx; }
.privacy-note__title { margin-bottom: 6rpx; color: #312e81; font-weight: 700; }
.inline-notice { margin-top: 20rpx; padding: 18rpx 20rpx; color: #92400e; background: #fffbeb; border-radius: 12rpx; font-size: 24rpx; }
.protection-card { display: flex; overflow: hidden; background: #fff; border: 2rpx solid #dbe3ef; border-radius: 20rpx; }
.protection-card__rail { flex: 0 0 18rpx; background: linear-gradient(180deg, #4338ca, #0f766e); }
.protection-card__body { flex: 1; min-width: 0; padding: 28rpx; }
.backup-state { display: flex; align-items: center; gap: 18rpx; padding-bottom: 24rpx; border-bottom: 2rpx solid #e2e8f0; }
.backup-state__mark { width: 20rpx; height: 20rpx; background: #d97706; border: 8rpx solid #fef3c7; border-radius: 50%; }
.backup-state--healthy .backup-state__mark { background: #047857; border-color: #d1fae5; }
.backup-state--danger .backup-state__mark { background: #b91c1c; border-color: #fee2e2; }
.backup-state__label { font-size: 30rpx; font-weight: 750; }
.backup-state__detail { margin-top: 2rpx; color: #64748b; font-size: 23rpx; }
.protection-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; padding: 24rpx 0 8rpx; text-align: center; }
.protection-metric text { display: block; font-size: 38rpx; font-weight: 800; }
.protection-metric view { color: #64748b; font-size: 21rpx; }
.protection-note { margin-top: 20rpx; padding: 18rpx 20rpx; color: #475569; background: #f8fafc; border-radius: 12rpx; font-size: 23rpx; }
.protection-empty { color: #64748b; font-size: 25rpx; text-align: center; }
.protection-retry { min-height: 88rpx; margin-top: 8rpx; }
.logout-button { margin-top: 12rpx; }
.version-text { padding: 28rpx 0; color: #94a3b8; font-size: 22rpx; text-align: center; }
