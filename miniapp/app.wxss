page {
  --ink: #0f172a;
  --muted: #64748b;
  --primary: #4338ca;
  --primary-soft: #eef2ff;
  --success: #047857;
  --success-soft: #ecfdf5;
  --danger: #b91c1c;
  --danger-soft: #fef2f2;
  --surface: #ffffff;
  --canvas: #f8fafc;
  --line: #dbe3ef;
  background: var(--canvas);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 32rpx;
  line-height: 1.55;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.page-title { margin: 0; font-size: 52rpx; font-weight: 800; letter-spacing: -1rpx; }
.page-kicker { margin: 0 0 8rpx; color: var(--primary); font-size: 24rpx; font-weight: 700; letter-spacing: 3rpx; }
.page-lead { margin: 8rpx 0 32rpx; color: var(--muted); font-size: 28rpx; }

.card {
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
}

.section-heading { margin: 36rpx 0 16rpx; font-size: 34rpx; font-weight: 750; }
.field { margin-bottom: 28rpx; }
.field-label { display: block; margin-bottom: 10rpx; font-size: 28rpx; font-weight: 650; }
.field-hint { margin-top: 8rpx; color: var(--muted); font-size: 24rpx; }
.field-error { margin-top: 8rpx; color: var(--danger); font-size: 24rpx; }

.input,
.picker-value,
.textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  color: var(--ink);
  background: #ffffff;
  border: 2rpx solid #cbd5e1;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.textarea { min-height: 176rpx; }
.input-error { border-color: var(--danger); background: var(--danger-soft); }

.button-primary,
.button-secondary,
.button-danger,
.button-text {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 18rpx 28rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.button-primary { color: #ffffff; background: var(--primary); border: 2rpx solid var(--primary); }
.button-secondary { color: var(--primary); background: var(--primary-soft); border: 2rpx solid #c7d2fe; }
.button-danger { color: var(--danger); background: var(--danger-soft); border: 2rpx solid #fecaca; }
.button-text { color: var(--primary); background: transparent; border: 2rpx solid transparent; }
.button-primary[disabled], .button-secondary[disabled] { color: #94a3b8; background: #e2e8f0; border-color: #e2e8f0; }
.button-primary:active, .button-secondary:active, .button-danger:active, .button-text:active { opacity: .72; }
button::after { border: 0; }

.state-panel { padding: 64rpx 32rpx; color: var(--muted); text-align: center; }
.state-title { margin-bottom: 8rpx; color: var(--ink); font-size: 32rpx; font-weight: 700; }
.state-action { margin-top: 24rpx; }
.status-pill { display: inline-flex; padding: 6rpx 16rpx; color: var(--success); background: var(--success-soft); border-radius: 999rpx; font-size: 22rpx; font-weight: 700; }

@media (min-width: 768px) {
  .page-shell { width: 720px; margin: 0 auto; padding-left: 48rpx; padding-right: 48rpx; }
}
