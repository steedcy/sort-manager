# Backend
DB_ROOT_PASSWORD=
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/sort_manager?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=sort_manager_app
DB_PASSWORD=change-me
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
JPA_DDL_AUTO=validate
DB_DRIVER=com.mysql.cj.jdbc.Driver
JPA_SHOW_SQL=false
HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_UPLOAD_PATH=uploads/
APP_LOG_LEVEL=DEBUG
# Required: generate a private random value containing at least 32 UTF-8 bytes.
APP_JWT_SECRET=
APP_JWT_ACCESS_TTL_SECONDS=900
APP_REFRESH_TTL_DAYS=30
APP_LOGIN_MAX_ATTEMPTS=5
APP_LOGIN_BLOCK_SECONDS=600
APP_LOGIN_MAX_TRACKED_ATTEMPTS=10000
APP_BOOTSTRAP_USERNAME=owner
# Required on the first startup: use a unique password with at least 10 characters.
APP_BOOTSTRAP_PASSWORD=
APP_BOOTSTRAP_DISPLAY_NAME=家庭管理员
APP_BOOTSTRAP_HOUSEHOLD_NAME=我的家庭
APP_BACKUP_STATUS_PATH=
APP_BACKUP_STALE_AFTER_HOURS=48

# Backup task (ops/backup.ps1 only; keep BACKUP_PASSPHRASE in the scheduler secret store)
BACKUP_OUTPUT_PATH=
BACKUP_PASSPHRASE=

# Frontend
VITE_API_BASE=/api/v1
FRONTEND_PORT=5173
APP_HTTP_PORT=8090
BACKEND_URL=http://localhost:8080
